  ],
  "title": "WorkflowHandoffResult",
  "type": "object",
  "x-stage-rules": {
    "ATLAS_BOOTSTRAP": {
      "system_derived": [
        "artifact_paths"
      ]
    },
    "ATLAS_REFRESH": {
      "system_derived": [
        "artifact_paths"
      ]
    },
    "BATCH_CONTINUATION": {
      "required_non_empty": [
        "batch_id",
        "chunk_ids"
      ]
    },
    "CORE_INNOVATION_PROPOSAL": {
      "system_derived": [
        "innovation_ids",
        "artifact_paths"
      ]
    },
    "DISTILL": {
      "required_non_empty": [
        "distill_id",
        "distill_source_ids",
        "distill_dimensions",
        "distill_skill_root"
      ]
    },
    "DRAFT_AND_VALIDATE": {
      "system_derived": [
        "draft_id",
        "contract_id",
        "task_ids"
      ]
    },
    "FOUNDATION_DEVELOPMENT_PROPOSAL": {
      "system_derived": [
        "artifact_paths"
      ]
    },
    "IMPACT_AND_PLAN": {
      "required_non_empty": [
        "campaign_id"
      ],
      "system_derived": [
        "artifact_paths"
      ]
    },
    "KERNEL_CONTRACT_DISCOVERY": {
      "system_derived": [
        "artifact_paths"
      ]
    },
    "NOVEL_DISTILLATION": {
      "required_non_empty": [
        "distill_id",
        "distill_source_ids",
        "distill_dimensions",
        "distill_skill_root"
      ]
    },
    "NOVEL_INITIALIZATION": {
      "required_non_empty": [
        "initialization_id",
        "completed_arc_ids",
        "readiness"
      ]
    },
    "PLAN_ONLY": {
      "system_derived": [
        "candidate_ids",
        "task_ids"
      ]
    },
    "READER_KERNEL_PROPOSAL": {
      "system_derived": [
        "artifact_paths"
      ]
    },
    "STORY_FOUNDATION_PROPOSAL": {
      "system_derived": [
        "candidate_ids",
        "artifact_paths"
      ]
    },
    "WORLD_MODEL_REVIEW": {
      "required_non_empty": [
        "review_queue_ids"
      ]
    }
  }
}
